# ==========================================================================
# 환경 변수 예시 — 이 파일을 복사해 .env 를 만들고 값을 채우세요.
#   copy .env.example .env
# .env 는 절대 커밋하지 마세요.
# ==========================================================================

# --- MySQL ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=kenshin_reservation
# 서버 기동 시 DB 생성 · 스키마 마이그레이션 · 필수 초기 데이터(관리자 계정 · 메일 문구)를
# 자동으로 맞춘다. 배포 절차에서 직접 돌리려면 false 로 두고 python -m scripts.setup_db.
DB_AUTO_MIGRATE=true

# --- 애플리케이션 --------------------------------------------------------
# 운영으로 돌릴 때 production 으로 바꾼다.
# production(또는 ADMIN_COOKIE_SECURE=true)이면 SECRET_KEY 가 아래 기본값
# 그대로일 때 **서버가 뜨지 않는다.** 기본 관리자 비밀번호가 남아 있으면
# 기동 로그에 경고가 남는다.
ENV=development
# 본인 확인 토큰 · 관리자 세션 서명 키. 운영에서는 반드시 무작위 값으로 교체할 것.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me
# 본인 확인 토큰 유효 시간(초). 기본 30분.
VERIFY_TOKEN_TTL=1800

# --- 관리 화면 -----------------------------------------------------------
# 관리자 세션 유효 시간(초). 기본 8시간.
ADMIN_SESSION_TTL=28800
# HTTPS 로 서비스할 때만 true. 로컬(http)에서 true 로 두면 로그인이 되지 않는다.
ADMIN_COOKIE_SECURE=false

# --- 예약 자동 삭제 ------------------------------------------------------
# 검진 시각으로부터 몇 분이 지나면 예약 기록을 삭제할지. 기본 60분.
#   예) 8월 7일 09:00 예약 → 8월 7일 10:00 에 삭제
RESERVATION_EXPIRE_GRACE_MINUTES=60
# 자동 정리 주기(분). 0 이면 자동 실행하지 않고 수동 스크립트만 사용한다.
RESERVATION_PURGE_INTERVAL_MINUTES=10

# --- 우편번호(주소) 데이터 -----------------------------------------------
# 「주소 찾기」가 이 데이터 위에서 돈다. 없으면 검색이 조용히 0건을 돌려준다.
# true 면 기동할 때 확인하고, 비어 있으면 백그라운드로 내려받아 적재한다
# (1~2분, 기동을 막지는 않는다).
POSTAL_AUTO_IMPORT=true
# 이 수 미만이면 「온전하지 않음」으로 보고 다시 적재한다. 전체는 12만 건 남짓.
POSTAL_MIN_ROWS=100000
# 인터넷이 없는 환경이면 받아 둔 utf_ken_all.csv 의 경로를 적는다.
POSTAL_SOURCE_FILE=

# --- 메일 발신 (미정이면 비워 둘 것) -------------------------------------
# RESEND_API_KEY 가 비어 있으면 실제 발송 없이 mail_logs 에만 기록한다.
RESEND_API_KEY=
MAIL_FROM=kenshin@example.jp
MAIL_FROM_NAME=医療法人 Sample Group 健康診断予約センター

# --- 접속 IP 판정 --------------------------------------------------------
# 리버스 프록시(Nginx 등) 뒤에 둘 때만 true 로 바꾼다.
# X-Forwarded-For 는 누구나 위조할 수 있으므로, 프록시 없이 true 로 두면
# 예약 조회의 시도 횟수 제한을 헤더만 바꿔 가며 우회할 수 있다.
TRUST_PROXY_HEADER=false

# --- 문의처 (검진 대상자가 아닌 경우 안내) -------------------------------
CONTACT_TEL=03-1234-5678
CONTACT_EMAIL=kenshin@example.jp
CONTACT_HOURS=平日 9:00～17:00 (土・日・祝日を除く)

# --- 프론트엔드 URL ----------------------------------------------------
# 이메일 발송 시 사용되는 프론트엔드 주소입니다.
FRONTEND_URL=http://127.0.0.1:8000

